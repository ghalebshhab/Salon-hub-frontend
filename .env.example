# Base URL the axios client uses. In development this proxied /api path.
# In production set this to the full backend origin (see .env.production).
VITE_API_BASE_URL=/api

# Local dev: Vite proxy forwards /api → this target.
VITE_API_PROXY_TARGET=http://localhost:8081

# Google Maps JavaScript API + Places API browser key.
# Restrict this key to your frontend domains in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# --- Production values (already set in .env.production) ---
# VITE_API_BASE_URL=https://salon-hub-backend.onrender.com/api
# VITE_API_PROXY_TARGET=https://salon-hub-backend.onrender.com
